# Copia este archivo a .env.local y llena los valores.

# Municipio que sirve este despliegue. Debe coincidir con un `id` del registro
# en src/config/municipios.ts. Si se deja vacío, usa Cali.
# El mismo código desplegado dos veces con valores distintos son dos sitios.
NEXT_PUBLIC_MUNICIPIO=cali

# .env.local está en .gitignore y NUNCA debe subirse al repo.
#
# Los dos valores de abajo salen de Supabase → Project Settings → API.
# Ambos son públicos por diseño (viajan al navegador de cada visitante); lo que
# protege los datos es RLS, no el secreto de la anon key.

NEXT_PUBLIC_SUPABASE_URL=https://TU-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto que protege /api/revalidar, el endpoint que purga la caché cuando
# editas datos en Supabase. Este SÍ es secreto: sin él cualquiera podría
# disparar regeneraciones. Genera uno con:  openssl rand -hex 32
# Va también en Vercel (Settings -> Environment Variables) y en la cabecera
# x-revalidate-secret del Database Webhook de Supabase.
REVALIDATE_SECRET=

# NO agregues aquí la service_role key. No la necesita ninguna parte de F0 y si
# se filtra, salta por encima de todas las políticas de RLS.
